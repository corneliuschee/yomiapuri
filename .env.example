# Optional local AI translation runtime.
# This runs one stateless translation request at a time. Reader text is sent only
# to the local Python process through stdin and is not stored by the app.
LOCAL_TRANSLATION_COMMAND=.venv-liquidai\Scripts\python.exe scripts\lfm2_translate.py
LOCAL_TRANSLATION_TIMEOUT_MS=120000

# Optional: keep Hugging Face model files inside ignored local data storage.
HF_HOME=data\huggingface
TRANSFORMERS_CACHE=data\huggingface\transformers
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
