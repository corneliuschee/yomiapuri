# Optional local AI translation runtime.
# This starts/reuses a local llama.cpp server. Reader text is sent only to the
# local process and is not stored by the app.
# FastAPI manages llama-server directly; no JavaScript command is used.
LOCAL_TRANSLATION_CONTEXT_SIZE=1536
LOCAL_TRANSLATION_SERVER_STARTUP_MS=180000
LOCAL_TRANSLATION_REQUEST_MS=180000
LLAMA_SERVER_PATH=D:\YomiApuriModels\llama-tools\b9785-cuda-13.3\llama-server.exe
# Recommended: Windows RTX desktop 24, 16 GB Apple Silicon Mac 16.
LLAMA_GPU_LAYERS=24
LLAMA_NO_WARMUP=true
LLAMA_IDLE_TIMEOUT_SECONDS=600
SUGOI_Q4_MODEL_PATH=D:\YomiApuriModels\Sugoi-14B-Ultra-GGUF\Sugoi-14B-Ultra-Q4_K_M.gguf
SUGOI_Q3_MODEL_PATH=D:\YomiApuriModels\Sugoi-14B-Ultra-GGUF\Sugoi-14B-Ultra-Q3_K_M.gguf
SUGOI_Q4_ENDPOINT=http://127.0.0.1:8094/v1/chat/completions
SUGOI_Q3_ENDPOINT=http://127.0.0.1:8093/v1/chat/completions
